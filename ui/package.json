{
  "name": "clearai-dsh",
  "version": "0.0.0-dev",
  "private": true,
  "description": "开发形态的面板半：由 install.sh 摊进 profile 的 node_modules，供宿主套件与本地调试使用。发行物的清单是仓库根目录那份 package.json（`lib/host.js` + `lib/fold.js` + `lib/client.js` + `presets/`）。",
  "type": "module",
  "main": "lib/index.js",
  "dependencies": {
    "zod": "^4.6.1"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
