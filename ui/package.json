{
  "name": "clearai-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "ClearAI(DSH 版):宿主平面注册会话投影单元 `clearai`(纯 fold,把工具写下的变更记录算成视图),浏览器平面把它渲染成右栏「进展 / 世界树 / 外脑」、中栏「产物」与输入框下方的状态条——目标 → 假设 → 验证与工作 → 世界线 → 资料 → 事实。",
  "type": "module",
  "main": "lib/index.js",
  "dependencies": {
    "zod": "^4.6.1"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
