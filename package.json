{
  "name": "clearai-dsh",
  "version": "0.1.6",
  "description": "ClearAI: The Epistemic Loop, native to DSH.",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clearailhc/clearai-dsh.git"
  },
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./invariant": "./lib/invariant.js"
  },
  "bin": {
    "clearai-dsh": "bin/clearai.mjs"
  },
  "files": [
    "lib",
    "presets",
    "bin",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "brand"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.6.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "clearai",
    "agent-preset",
    "evidence",
    "worldline"
  ],
  "scripts": {
    "test": "bash test/run.sh",
    "build": "node tools/build-package.mjs",
    "verify": "node tools/verify-package.mjs",
    "verify:deploy": "node tools/verify-deploy.mjs",
    "verify:install": "node tools/verify-clean-install.mjs",
    "pack": "node tools/build-package.mjs && npm pack ./dist/clearai-dsh",
    "release": "node tools/build-package.mjs && node tools/verify-package.mjs && node tools/verify-clean-install.mjs && npm pack ./dist/clearai-dsh --pack-destination dist",
    "e2e": "node tools/e2e-run.mjs",
    "e2e:long": "node tools/e2e-parallel.mjs"
  }
}
